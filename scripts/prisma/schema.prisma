enum oauth_response_type {
  code

  @@schema("auth")
}

enum one_time_token_type {
  confirmation_token
  reauthentication_token
  recovery_token
  email_change_token_new
  email_change_token_current
  phone_change_token

  @@schema("auth")
}

model application_state {
  id         String   @id @default("current_state")
  state      Json?
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([id])
  @@schema("public")
}

enum PaymentMethod {
  NUMERARIO
  TPA
  QRCODE
  TRANSFERENCIA

  @@schema("public")
}

// ============================================
// EVENTOS E PACOTES
// ============================================

enum EventType {
  ANIVERSARIO
  CASAMENTO
  ALUGUER_TOTAL
  ALUGUER_PARCIAL
  SHOW_INTIMISTA
  CORPORATIVO
  BATIZADO
  OUTRO

  @@schema("public")
}

enum EventStatus {
  PLANEADO
  CONFIRMADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO

  @@schema("public")
}

enum EventArea {
  SALA_PRINCIPAL
  TERRACO
  SALAO_PRIVADO
  RESTAURANTE_INTEIRO

  @@schema("public")
}

enum ConsumptionType {
  ILIMITADO      // Open bar, buffet livre
  LIMITADO       // X bebidas/por pessoa
  PACOTE_FECHADO // Menu fixo
  CONSUMO_POS    // Pedidos via POS

  @@schema("public")
}

enum EventOrderType {
  INCLUIDO  // Já pago no pacote do evento
  EXTRA     // Consumo adicional a cobrar

  @@schema("public")
}

/// Pacotes de evento editáveis (ex: Pacote Aniversário 10 pessoas)
model event_packages {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String                           // "Pacote Aniversário Básico"
  description     String?                          // Descrição detalhada
  event_type      EventType?                       // Tipo de evento recomendado
  
  // Configuração de pessoas
  min_guests      Int?            @default(1)    // Mínimo de convidados
  max_guests      Int?            @default(10)   // Máximo de convidados
  
  // Itens incluídos no pacote
  included_items  Json?           @default("[]") // [{"product_id": "uuid", "name": "Cerveja", "quantity_per_person": 3, "unlimited": false}]
  
  // Preços
  base_price      Decimal?        @default(0) @db.Decimal(12, 2)  // Preço base do pacote
  price_per_person Decimal?       @default(0) @db.Decimal(12, 2) // Preço adicional por pessoa
  
  // Áreas permitidas
  allowed_areas   String[]        @default([])    // ["SALAO_PRIVADO", "TERRACO"]
  
  // Configuração
  is_active       Boolean?        @default(true)
  duration_hours  Int?            @default(4)    // Duração padrão do evento
  
  // Metadados
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?       @default(now()) @db.Timestamptz(6)
  events          events[]

  @@index([event_type], map: "idx_event_packages_type")
  @@index([is_active], map: "idx_event_packages_active")
  @@schema("public")
}

/// Eventos do restaurante
model events {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  // Informações básicas
  name              String                           // Nome do evento (ex: "Aniversário Maria")
  type              EventType
  status            EventStatus?    @default(PLANEADO)
  
  // Responsável/Cliente
  customer_name     String
  customer_phone    String?
  customer_email    String?
  
  // Datas e horários
  start_date        DateTime        @db.Date
  end_date          DateTime?       @db.Date         // Para eventos multi-dia
  start_time        String?                          // "19:00"
  end_time          String?                          // "23:00"
  
  // Localização
  area              EventArea?
  tables_reserved   Int[]           @default([])    // IDs das mesas reservadas [1, 2, 3]
  
  // Convidados
  guests_count      Int             @default(0)
  guests_confirmed  Int?            @default(0)     // Confirmados
  
  // Pacote associado
  package_id        String?         @db.Uuid
  package           event_packages? @relation(fields: [package_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  
  // Itens do pacote personalizados para este evento
  included_items    Json?           @default("[]") // Itens com quantidades específicas
  
  // Configuração de consumo
  consumption_mode  ConsumptionType? @default(PACOTE_FECHADO)
  
  // Valores financeiros
  base_amount       Decimal?        @default(0) @db.Decimal(12, 2)  // Valor do pacote
  extras_amount     Decimal?        @default(0) @db.Decimal(12, 2) // Consumo extra via POS
  deposit_amount    Decimal?        @default(0) @db.Decimal(12, 2) // Sinal/entrada paga
  final_amount      Decimal?        @default(0) @db.Decimal(12, 2) // Total final
  
  // Notas
  notes             String?                          // Observações gerais
  special_requests  String?                          // Pedidos especiais (alergias, decoração)
  
  // Equipa
  assigned_staff    String[]        @default([])    // IDs dos funcionários atribuídos
  
  // Fornecedores externos
  external_suppliers Json?          @default("[]")  // [{"name": "DJ João", "type": "DJ", "phone": "999...", "cost": 50000}]
  
  // Cronograma
  schedule          Json?           @default("[]")  // [{"time": "19:00", "activity": "Chegada", "responsible": "Garçom 1"}]
  
  // Metadados
  created_at        DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?       @default(now()) @db.Timestamptz(6)
  created_by        String?         @db.Uuid        // Quem criou
  
  // Relações
  event_orders      event_orders[]

  @@index([start_date], map: "idx_events_date")
  @@index([status], map: "idx_events_status")
  @@index([type], map: "idx_events_type")
  @@index([package_id], map: "idx_events_package")
  @@schema("public")
}

/// Pedidos vinculados a eventos (via POS)
model event_orders {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  // Ligação ao evento
  event_id        String          @db.Uuid
  event           events          @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  
  // Ligação ao pedido original (orders)
  order_id        String          @unique @db.Uuid
  
  // Configuração
  order_type      EventOrderType  @default(INCLUIDO)  // INCLUIDO = no pacote, EXTRA = cobrar
  table_number    Int?                             // Mesa do evento
  
  // Se for item ilimitado do pacote
  is_unlimited    Boolean?        @default(false)  // Se é open bar/buffet livre
  unlimited_type  String?                          // "DRINKS", "FOOD"
  
  // Metadados
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?       @default(now()) @db.Timestamptz(6)

  @@index([event_id], map: "idx_event_orders_event")
  @@index([order_type], map: "idx_event_orders_type")
  @@schema("public")
}
